# ── Obligatorias ─────────────────────────────────────────────────────────────
# MySQL. En Railway: referencia a la variable MYSQL_URL del servicio MySQL.
DATABASE_URL=mysql://usuario:clave@host:3306/base

# Dirección pública del sitio, sin barra final. Stripe vuelve a esta dirección después del pago.
SITE_URL=https://madisondor.com

# Acceso al panel /admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Cadena larga y aleatoria. Sin ella la sesión del panel se cierra en cada reinicio.
SESSION_SECRET=

# ── Pagos (Stripe) ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
# Secreto del webhook que apunta a  {SITE_URL}/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# "true" para que Stripe Tax calcule el impuesto a las ventas (hay que activarlo antes en Stripe)
STRIPE_AUTOMATIC_TAX=false

# ── Correo (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
# Remitente de un dominio verificado en Resend
EMAIL_FROM=Madison D'Or <pedidos@madisondor.com>
# Quién recibe los avisos de pedidos nuevos y del formulario de contacto
ORDERS_EMAIL=Madisondor18k@gmail.com

# ── Fotos (Cloudflare R2) ────────────────────────────────────────────────────
# Sin estas cinco, las fotos subidas en el panel se guardan en disco y se pierden al redesplegar.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://media.madisondor.com
